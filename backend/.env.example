# Comma-separated browser origins, without paths. No cookies/credentials required.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For a separate production frontend, replace with its exact HTTPS origin:
# CORS_ALLOW_ORIGINS=https://example.com
# Optional local reference bundle override; must exist on the backend host.
# LUNANAV_DATA_DIR=/absolute/path/to/data
# This file is an example, not automatically loaded. Set environment variables
# in your host configuration or shell before starting Uvicorn.
