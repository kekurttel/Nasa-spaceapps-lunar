{
  "name": "lunar-sight-unified",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.6.0" },
  "scripts": {
    "start": "node --experimental-strip-types server/app.mjs",
    "test:integration": "node --experimental-strip-types --test tests/integration/app*.test.mjs",
    "test:data": "node --test src/features/data/tests/*.test.mjs tests/integration/data-contract.test.mjs",
    "prepare:science": "node scripts/prepare-data.mjs --setup-python --test",
    "verify:science-data": "node scripts/prepare-data.mjs --verify-only",
    "polar:snapshots": "node --experimental-strip-types scripts/run-polar-snapshots.mjs",
    "test:polar-snapshots": "node --experimental-strip-types --test src/features/analysis/tests/polar-snapshot.test.mjs tests/polar-snapshot-grid.test.mjs",
    "test:ephemeris": "node --experimental-strip-types --test src/features/ephemeris/tests/*.test.ts",
    "build": "npm --prefix frontend run build"
  }
}
